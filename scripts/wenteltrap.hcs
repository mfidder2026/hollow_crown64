# wenteltrap.hcs — hoofdstuk 6: de wenteltrap, van de troonzaal omhoog naar het dak (van rechts naar links).
# Plaatje: data/plaatjes/wenteltrap.png (tools/teken_tussen.py). Een loopscherm: links en rechts een uitgang.
KAMER wenteltrap
  LOOPKLEUREN grijs lichtgrijs donkergrijs zwart wit bruin oranje geel blauw lichtblauw paars cyaan
  LOOPVAK 129,101 155,115                  # onderaan
  LOOPVAK 107,92 133,106
  LOOPVAK 85,84 111,97
  LOOPVAK 63,75 89,89
  LOOPVAK 41,66 67,80
  LOOPVAK 19,57 45,71
  LOOPVAK 2,53 23,62                  # bovenaan
  BINNENKOMST:
    MUZIEK kelder

VOORWERP wt_dak "trap" VAK 0,36 12,24 LOOP 5,56 LINKS
  GA_NAAR:
    KAMER dak 80,112 VOOR
  BEKIJK:
    ZEG eldric "De trap omhoog. Naar het dak, naar de manen."

VOORWERP wt_terug "troonzaal" VAK 152,100 8,20 LOOP 153,112 RECHTS
  GA_NAAR:
    KAMER troonzaal 6,120 RECHTS
  BEKIJK:
    ZEG eldric "Terug naar de troonzaal."

VOORWERP wt_raam "raam" VAK 36,24 10,38 LOOP 40,69 RUG
  BEKIJK:
    ZEG eldric "Door het smalle raam zie ik de twee manen. Ze staan stil."

VOORWERP wt_treden "treden" VAK 4,40 156,60 LOOP 80,87 RUG
  BEKIJK:
    ZEG eldric "Honderden treden. Mijn benen weten het al."
