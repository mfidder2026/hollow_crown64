# aardstad.hcs — hoofdstuk 4: de stad van de aardmannetjes (data/plaatjes/aardstad.png, met de hand getekend:
# tools/teken_kloof.py). Moeder Aard vertelt hoe het echt zit (met de fluisterkever), toont het laatste ei (patch ei:
# het gloeit, net als Mira's steen) en geeft de sleutelschub.
KAMER aardstad
  LOOPKLEUREN bruin oranje zwart
  LOOPVAK 4,100 156,122
  BINNENKOMST:
    MUZIEK kelder
    ALS vlag ei_gezien
      PATCH ei
    EINDE

VOORWERP moeder "Moeder Aard" VAK 68,52 20,32 LOOP 78,102 RUG
  BEKIJK:
    ZEG eldric "Een oud aardmannetje met wit haar en een omslagdoek."
    ZEG eldric "Ze is wakker. Ze kijkt naar mij."
  PRAAT:
    ALS vlag moeder_gesproken
      ZEG kever "Praat met Grom, jongen. Niet vechten. Praten."
    ANDERS
      ZEG eldric "Goedenavond, mevrouw?"
      ZEG eldric "Ze antwoordt, maar het klinkt als kiezels. Ik heb de kever nodig."
    EINDE
  GEBRUIK fluisterkever:
    ALS vlag moeder_gesproken
      ZEG kever "Praat met Grom, jongen. Niet vechten. Praten."
    ANDERS
      TUSSENSCENE
      ZEG kever "Jij bent de jongen met het stukje zon. Nul heeft over je gezongen."
      ZEG kever "Mijn volk is niet gelukkig in de schemer."
      ZEG kever "Er groeit niets. De kinderen zijn zwak."
      ZEG kever "Grom houdt van ons. Maar hij denkt dat het licht ons doodt."
      ZEG kever "Het is te veel licht dat ons doodt. Een dal met schaduw zou genoeg zijn."
      ZEG eldric "Een dal met schaduw... en de rest krijgt de zon terug?"
      ZEG kever "Kijk. Onze eierkamer. Leeg, op één ei na."
      PATCH ei
      ZET ei_gezien
      ZEG mira "Mijn steen... hij wordt warm. Hij gloeit!"
      ZEG kever "Dat ei is van ons. Het wil nog niet uit. Het wacht ergens op."
      ZEG kever "Neem deze schub mee. Hij opent de poort van het kasteel."
      GEEF sleutelschub
      ZEG kever "Praat met Grom. Niet vechten. Praten."
      ZET moeder_gesproken
      PUNTEN 20
      EINDE_TUSSENSCENE
    EINDE

VOORWERP eieren "eierkamer" VAK 122,40 32,36 LOOP 140,102 RUG
  BEKIJK:
    ALS vlag ei_gezien
      ZEG eldric "Eén ei, en het gloeit zoals Mira's steen."
    ANDERS
      ZEG eldric "Een kamer met kuiltjes. Allemaal leeg, op één na."
    EINDE

VOORWERP slapers "slapers" VAK 0,6 120,44 LOOP 40,104 RUG
  BEKIJK:
    ZEG eldric "Honderden nissen, in elke nis een slapend aardmannetje. Ze snurken zacht."
  PRAAT:
    ZEG mira "Sst. Laat ze slapen."

VOORWERP gang_spreuk "gang" VAK 150,78 10,18 LOOP 154,104 RECHTS
  BEKIJK:
    ZEG eldric "Een gang naar rechts. Er staan manen op de muur gekrast."
  GA_NAAR:
    ALS vlag moeder_gesproken
      KAMER spreukzaal 16,114 RECHTS
    ANDERS
      ZEG mira "Wacht. Die oude vrouw is wakker. Ze wil met je praten, Eldric."
    EINDE

VOORWERP gang_zwam "gang" VAK 0,78 10,18 LOOP 6,104 LINKS
  BEKIJK:
    ZEG eldric "Terug naar de zwamgrot."
  GA_NAAR:
    KAMER zwamgrot 148,112 LINKS
