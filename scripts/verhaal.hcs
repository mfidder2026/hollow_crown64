# verhaal.hcs — de verhaalanimatie na het titelscherm: het verhaal zoals het volk het kent (de waarheid komt later,
# zie het scenario). Eén toneel (data/plaatjes/toneel.png, met de hand getekend: tools/teken_toneel.py), figuren als
# sprites, en de lucht die met KLEUR stap voor stap donker wordt. Vuur of spatie slaat alles over.
KAMER verhaal
  TONEEL
  LOOPKLEUREN geel oranje
  SCHAAL 118 110
  LOOPVAK 74,106 86,124                  # het pad: hier loopt Eldric aan het eind het beeld in
  ACTOR maan_l KOSTUUM maan OP 34,26 VERBORGEN
  ACTOR maan_r KOSTUUM maan OP 126,26 VERBORGEN
  ACTOR hol_1 KOSTUUM hol OP 128,127 VERBORGEN
  ACTOR hol_2 KOSTUUM hol OP 138,127 VERBORGEN
  ACTOR vex_toneel KOSTUUM vex OP 30,62 VERBORGEN
  BINNENKOMST:
    TUSSENSCENE
    MUZIEK thema
    WACHT 50
    ZEG verteller "Lang geleden leefde het rijk Aethermoor onder de Eeuwige Zon."
    ZEG verteller "Tot de nacht van de dubbele maansverduistering."
    TOON maan_l
    TOON maan_r
    LOOP maan_l 76,26
    LOOP maan_r 84,26
    KLEUR 64,0 32,40 geel oranje         # de zon dooft
    KLEUR 0,0 160,72 cyaan lichtblauw    # de lucht wordt donkerder
    WACHT 30
    KLEUR 64,0 32,40 oranje bruin
    KLEUR 0,0 160,72 lichtblauw blauw
    KLEUR 0,0 160,72 wit lichtgrijs      # de wolken (en het hart van de zon) worden grauw
    WACHT 30
    KLEUR 0,0 160,72 blauw paars         # de schemer van Dawnhaven
    KLEUR 0,0 160,72 lichtgrijs grijs
    VERBERG maan_l
    VERBERG maan_r
    ZEG verteller "Uit de Rotskloof steeg as op. Het werd schemer, en het bleef schemer."
    TOON hol_1
    LOOP hol_1 128,100
    TOON hol_2
    LOOP hol_2 138,108
    ZEG verteller "En uit de diepte kwamen holle wezens."
    VERBERG hol_1
    VERBERG hol_2
    TOON vex_toneel
    ZEG verteller "Baron Vex nam het kasteel en de Lichte Kroon."
    ZEG vex "De Holle Koning stal jullie zon! Alleen ik kan jullie beschermen."
    VERBERG vex_toneel
    TOON eldric
    LOOP eldric 80,108
    ZEG verteller "Maar één Wachter bleef over. In zijn zwaard gloeit het laatste licht."
    ZEG eldric "Ik ben Eldric. En ik breng het licht terug."
    WACHT 25
    EINDE_TUSSENSCENE
    KAMER plein 60,112 VOOR
