# klippad.hcs — hoofdstuk 3: van de boot het klippad op naar het eiland.
# Plaatje: data/plaatjes/klippad.png (tools/teken_tussen.py). Een loopscherm: links en rechts een uitgang.
KAMER klippad
  LOOPKLEUREN grijs lichtgrijs donkergrijs zwart groen lichtgroen wit bruin oranje
  LOOPVAK 2,106 157,120                  # het pad
  BINNENKOMST:
    MUZIEK zee

VOORWERP kp_boot "boot" VAK 0,96 6,28 LOOP 4,112 LINKS
  GA_NAAR:
    KAMER boot 80,110 RUG
  BEKIJK:
    ZEG eldric "Daar beneden ligt de boot. Olm wacht."

VOORWERP kp_eiland "eiland" VAK 154,96 6,28 LOOP 156,112 RECHTS
  GA_NAAR:
    KAMER eiland 30,112 RECHTS
  BEKIJK:
    ZEG eldric "Het pad gaat verder, naar de vuurtoren."

VOORWERP kp_toren "vuurtoren" VAK 132,40 18,32 LOOP 140,112 RUG
  BEKIJK:
    ZEG eldric "De vuurtoren. Zijn licht is uit. Al heel lang."

VOORWERP kp_touw "touw" VAK 10,94 140,10 LOOP 80,110 RUG
  BEKIJK:
    ZEG eldric "Een touw als leuning. Iemand heeft hier vaak gelopen."
