# plein.hcs — Dawnhaven, het dorpsplein (hoofdstuk 1 van het verhaal).
# Coördinaten zoals in de kamer: x 0-159 (multicolor-pixels), y 0-127 (pixelrijen). Een LOOPVAK is een
# rechthoek "x1,y1 x2,y2" (randen horen erbij). Vakken die elkaar overlappen zijn buren: daar loop je over.
# Het plaatje staat (nog) in data/kamers.txt.

KAMER plein
  SCHAAL 104 88 76 69        # diepte: vooraan groot; achteraan zo klein dat hij door de deuren past
                             # (deuren: achteraan ~14-16 hoog met de voet op y~66, smidse ~20 op y~78,
                             #  herberg ~26 op y~84; Eldric: 34 / 26 / 20 / 14 / 10 rijen; 10 = helemaal bovenaan)
  LOOPKLEUREN groen lichtgroen geel   # de voeten mogen alleen hierop staan (de build controleert elk LOOPVAK)
  ACHTER 72,62 86,75         # achter de fontein, bij het torentje: dan staat het torentje vóór Eldric
  LOOPVAK 7,100 157,124      # 0 voor: het gras en het pad vooraan
  LOOPVAK 27,88 59,101       # 1 links: het gele pad naar de smidse
  LOOPVAK 50,74 63,90        # 2 links omhoog, naast de fontein
  VRIJ 76,62 82,76           # de waterstraal en het torentje staan op het gras erachter: daar loop je achterlangs
  LOOPVAK 59,72 104,75       # 3 achter de fontein langs (dwars door de waterstraal)
  LOOPVAK 82,69 104,75       # 4 achter de fontein, rechts
  LOOPVAK 96,72 125,101      # 5 rechts: het pad omhoog
  LOOPVAK 73,65 94,69        # 6 helemaal bovenaan: het gras tussen de fontein en de huizen achteraan
  LOOPVAK 84,64 94,71        # 7 bovenaan rechts

# ---- voorwerpen (hoofdstuk 3) -----------------------------------------------------------------------------
# VOORWERP naam "naam op het scherm" VAK x,y breedte,hoogte LOOP x,y richting   (kamercoördinaten)
# Het eerste voorwerp waarvan het VAK onder de cursor ligt, telt: zet kleine dingen vóór grote.

VOORWERP fontein "fontein" VAK 62,74 39,26 LOOP 80,100 RUG     # alleen de bak: het gras erachter blijft vloer
  BEKIJK:
    ZEG eldric "Het water is zwart sinds de zon weg is. Er glinstert iets op de bodem."
  PAK:
    ZEG eldric "Muntjes! Mensen wensen hier van alles. Ik neem er één, voor het geluk."
    # GEEF munt           (hoofdstuk 4: in de inventaris; met een vlag zodat het maar één keer kan)
  GEBRUIK:
    ZEG eldric "Ik heb geen dorst. Niet naar zwart water, in elk geval."

VOORWERP smid "smid" VAK 0,56 26,44 LOOP 30,94 LINKS
  BEKIJK:
    ZEG eldric "Hier werkt Bram de smid. Het vuur is uit. Bram ook, zo te zien."
  OPEN:
    ZEG eldric "Bram zit binnen te mokken. Dat laat ik nog even zo."

VOORWERP herberg "herberg" VAK 126,26 34,70 LOOP 122,90 RECHTS
  BEKIJK:
    ZEG eldric "De herberg 'De Laatste Straal'. Daar brandt tenminste nog licht."

VOORWERP huizen "huizen" VAK 30,20 96,42 LOOP 88,66 RUG
  BEKIJK:
    ZEG eldric "Iedereen zit binnen. Sinds de schemering komt niemand meer buiten."
  OPEN:
    ZEG eldric "Op slot. Ik zou ook niet opendoen voor mezelf."
