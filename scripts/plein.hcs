# plein.hcs — Dawnhaven, het dorpsplein (hoofdstuk 1 van het verhaal).
# Coördinaten zoals in de kamer: x 0-159 (multicolor-pixels), y 0-127 (pixelrijen). Een LOOPVAK is een
# rechthoek "x1,y1 x2,y2" (randen horen erbij). Vakken die elkaar overlappen zijn buren: daar loop je over.
# Het plaatje staat (nog) in data/kamers.txt.

KAMER plein
  SCHAAL 104 88 76           # diepte: vooraan groot; achteraan zo klein dat hij door de deuren past
                             # (deuren: achteraan ~14-16 hoog met de voet op y~66, smidse ~20 op y~78,
                             #  herberg ~26 op y~84; Eldric: 34 / 26 / 20 / 14 rijen)
  LOOPKLEUREN groen lichtgroen geel   # de voeten mogen alleen hierop staan (de build controleert elk LOOPVAK)
  ACHTER 72,69 86,75         # achter de fontein, bij het torentje: dan staat het torentje vóór Eldric
  LOOPVAK 7,100 157,124      # 0 voor: het gras en het pad vooraan
  LOOPVAK 27,88 59,101       # 1 links: het gele pad naar de smidse
  LOOPVAK 50,74 63,90        # 2 links omhoog, naast de fontein
  VRIJ 76,62 82,76           # de waterstraal en het torentje staan op het gras erachter: daar loop je achterlangs
  LOOPVAK 59,72 104,75       # 3 achter de fontein langs (dwars door de waterstraal)
  LOOPVAK 82,69 104,75       # 4 achter de fontein, rechts
  LOOPVAK 96,72 125,101      # 5 rechts: het pad omhoog
