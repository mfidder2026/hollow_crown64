# smit.hcs — de smit van Bram. Plaatje: data/plaatjes/smit.png, met de hand getekend (tools/teken_smit.py).
KAMER smit
  LOOPKLEUREN bruin oranje geel grijs donkergrijs   # aarde (oranje: licht van het vuur), stro, steentjes, een hoefijzer
  SCHAAL 104
  LOOPVAK 2,112 157,124                  # 0 voor
  LOOPVAK 24,84 100,124                  # 1 midden, voor het smidsvuur (links het watervat, rechts het aambeeld)
  LOOPVAK 130,84 157,124                 # 2 rechts, bij de deur
  FLAKKER 64,56 32,16 rood oranje geel   # het smidsvuur: uit gloeien de kolen zacht na, aan flakkeren de vlammen
  ACTOR bram KOSTUUM bram OP 32,100      # Bram de smit, naast zijn blaasbalg

BINNENKOMST:
  MUZIEK smit                          # stoer, met hamerslagen
  ALS vlag smidsvuur_aan
    PATCH vuur_aan
  EINDE

VOORWERP deur_smit "deur" VAK 133,39 21,43 LOOP 142,90 RUG
  GA_NAAR:
    KAMER plein 30,94 RECHTS
  BEKIJK:
    ZEG eldric "Terug naar het plein."

VOORWERP smidsvuur "smidsvuur" VAK 54,24 52,58 LOOP 80,92 RUG
  BEKIJK:
    ALS vlag smidsvuur_aan
      ZEG eldric "Het vuur brandt weer. Voor het eerst sinds de zon weg is."
    ANDERS
      ZEG eldric "Koude as. Het smidsvuur is uit sinds de zon weg is."
    EINDE
  GEBRUIK zwaard:
    ALS vlag smidsvuur_aan
      ZEG eldric "Het brandt al."
    ANDERS
      ZEG eldric "Ik houd het zwaard in de as. Het lichtfragment gloeit op..."
      GELUID vuur
      PATCH vuur_aan
      ZET smidsvuur_aan
      ZEG bram "Het vuur! Het brandt weer! Wie ben jij, jongen?"
      ZEG eldric "Eldric. Wachter van de Lichte Kroon. De laatste."
      ZEG bram "Dan heb je dit nodig. Een lantaarn. Leeg, maar jij vindt wel olie."
      GEEF lantaarn
    EINDE

VOORWERP bram "Bram" VAK 26,66 13,36 LOOP 46,104 LINKS
  BEKIJK:
    ZEG eldric "Bram de smit. Groot, rood en chagrijnig."
  PRAAT:
    ALS vlag smidsvuur_aan
      ZEG bram "Met dit vuur maak ik weer ijzer. Dank je, Wachter."
    ANDERS
      ZEG bram "Vuur uit, lantaarn leeg, hoofd vol."
    EINDE
  GEEF munt:
    ALS vlag smidsvuur_aan
      ZEG bram "Een munt uit de fontein? Voor het geluk, dan."
      NEEM munt
      ZEG bram "Hier. Een vuursteen. Voor als je lantaarn ooit uitgaat."
      GEEF vuursteen
    ANDERS
      ZEG bram "Wat moet ik met goud zonder vuur? Ga weg."
    EINDE

VOORWERP aambeeld "aambeeld" VAK 102,84 26,24 LOOP 96,100 RECHTS
  BEKIJK:
    ZEG eldric "Een aambeeld. Zwaar en koud."
  PAK:
    ZEG eldric "Ha. Nee."

VOORWERP blaasbalg "blaasbalg" VAK 38,64 18,17 LOOP 50,96 RUG
  BEKIJK:
    ZEG eldric "Een blaasbalg. Daarmee maakt Bram het vuur heet."
  GEBRUIK:
    ALS vlag smidsvuur_aan
      ZEG eldric "Pfff, pfff. Het vuur laait op."
    ANDERS
      ZEG eldric "Blazen op koude as helpt niet. Er moet eerst vuur zijn."
    EINDE

VOORWERP gereedschap "gereedschap" VAK 6,20 36,34 LOOP 30,92 RUG
  BEKIJK:
    ZEG eldric "Tangen, hamers en hoefijzers. Alles netjes aan een haak."
  PAK:
    ZEG bram "Afblijven. Mijn gereedschap is mijn gereedschap."

VOORWERP schild "schild" VAK 134,12 20,24 LOOP 142,90 RUG
  BEKIJK:
    ZEG eldric "Een schild en twee zwaarden. Bram maakt mooi werk."
