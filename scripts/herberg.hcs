# herberg.hcs — de herberg "De Laatste Straal". Plaatje: data/plaatjes/herberg.png (voorlopig).
KAMER herberg
  LOOPKLEUREN oranje bruin geel          # de houten vloer (geel: het licht van het vuur op de vloer)
  # (geen SCHAAL: binnen blijft Eldric overal even groot, de grootste maat)
  LOOPVAK 36,86 50,124                   # 0 links, bij de haard en de deur (links daarvan de oven)
  LOOPVAK 97,88 143,124                  # 1 rechts, langs het vat en de toog (rechts staat een emmer)
  LOOPVAK 36,108 157,124                 # 2 voor de tafel langs (achter de tafel is geen plek)
  FLAKKER 12,64 16,16 rood oranje geel  # het haardvuur
  ACTOR mira KOSTUUM mira OP 132,104     # Mira, bij de toog

BINNENKOMST:
  MUZIEK herberg                       # een zachte, speelse wals
  ALS vlag tafel_geschoven
    PATCH tafel_weg
  EINDE
  ALS vlag ziensteen_gepakt              # (na tafel_weg: die tekent de steen er nog bij)
    PATCH steen_weg
  EINDE
  ALS vlag kruik_gepakt
    PATCH kruik_weg
  EINDE

VOORWERP deur "deur" VAK 40,46 11,38 LOOP 45,88 RUG
  GA_NAAR:
    KAMER plein 122,90 VOOR
  BEKIJK:
    ZEG eldric "Naar het plein. Daar is het donker en hier warm."

VOORWERP ziensteen "ziensteen" VAK 58,103 8,7 LOOP 62,112 RUG NERGENS
  BEKIJK:
    ZEG eldric "Een gladde steen met een gat erin. Hij glimt een beetje."
  PAK:
    ZEG eldric "Die neem ik mee. Misschien is iemand hem kwijt."
    GEEF ziensteen
    PATCH steen_weg                      # weg van de vloer (tafel_weg tekende hem)
    ZET ziensteen_gepakt

VOORWERP tafel "tafel" VAK 54,86 36,16 LOOP 70,110 RUG
  BEKIJK:
    ZEG eldric "Een eikenhouten tafel. Er ligt iets onder, in het donker."
  DUW:
    ALS vlag tafel_geschoven
      ZEG eldric "Hij staat goed zo."
    ANDERS
      ZEG eldric "Hup."
      PATCH tafel_weg
      ZET tafel_geschoven
      PLAATS ziensteen herberg
      PUNTEN 10
      ZEG eldric "Daar ligt een steen. Met een gat erin."
    EINDE
  TREK:
    ZEG eldric "Duwen gaat makkelijker. Denk ik."

VOORWERP kruik "kruik" VAK 139,28 8,20 LOOP 140,90 RUG
  BEKIJK:
    ALS STAND kruik 1
      ZEG eldric "Een kruik vol lampolie. Niet opdrinken."
    ANDERS
      ZEG eldric "Een lege aardewerken kruik."
    EINDE
  PAK:
    ZEG eldric "Een lege kruik. Die kan van pas komen."
    GEEF kruik
    PUNTEN 5
    PATCH kruik_weg
    ZET kruik_gepakt

VOORWERP luik "luik" VAK 112,112 24,11 LOOP 108,116 RECHTS
  GA_NAAR:
    KAMER kelder 24,106 RECHTS
  OPEN:
    ZEG eldric "Een luik naar de kelder. Er komt een geur van olie omhoog."
  BEKIJK:
    ZEG eldric "Een luik in de vloer. Daaronder is vast de kelder."

VOORWERP biervat "vat" VAK 87,55 13,30 LOOP 98,90 RUG
  BEKIJK:
    ZEG eldric "Een biervat. Leeg, zo te horen. De lampolie staat vast in de kelder."
  PAK:
    ZEG eldric "Een leeg biervat. Wat moet ik daarmee?"
  GEBRUIK kruik:
    ZEG eldric "Hier zit geen olie in. Zelfs geen bier."

VOORWERP haard "haard" VAK 2,26 30,54 LOOP 36,90 LINKS
  BEKIJK:
    ZEG eldric "Het enige warme vuur in het dorp. Dit hout komt nog van voor de schemering."
  GEBRUIK zonnesteen:
    ZEG eldric "Dit vuur brandt al. Het heeft oma's steentje niet nodig."

VOORWERP mira "Mira" VAK 126,70 13,36 LOOP 116,108 RECHTS
  BEKIJK:
    ZEG eldric "Mira. Ze is blind, maar ze kijkt dwars door me heen."
  PRAAT:
    PRAAT mira
  GEEF ziensteen:
    ZEG eldric "Is dit van u?"
    ZEG mira "Mijn ziensteen! Ik voel het aan het gat. Dank je, jongen."
    NEEM ziensteen
    ZET ziensteen_terug
    PUNTEN 10
    ZEG mira "Ah, nu zie ik het pad weer. Het loopt langs de wolven."
    ZEG mira "Schaduwwolven vrezen licht. Bram de smit heeft een lantaarn."
    ZEG mira "De steen is warm. Hij is altijd warm. Rare steen."
    ZET hint_wolven
  GEEF munt:
    ZEG mira "Een munt uit de fontein? Hou hem maar. Wensen zijn niet te koop."

VOORWERP toog "toog" VAK 100,57 59,26 LOOP 120,90 RUG
  BEKIJK:
    ZEG eldric "Flessen, bekers en een plank. Geen waard te zien."

GESPREK mira
  KEUZE "Wie bent u?"
    ZEG eldric "Wie bent u?"
    ZEG mira "Mira. Ik zie niets, maar ik zie paden. Meestal."
  KEUZE "Ik moet het Duisterwoud in." ALS NIET vlag ziensteen_terug
    ZEG eldric "Ik moet het Duisterwoud in. Kunt u me de weg wijzen?"
    ZEG mira "Zonder mijn ziensteen zie ik geen enkel pad."
    ZEG mira "Hij rolde weg, daar bij de tafel. Onder de tafel, denk ik."
    ZET mira_zoekt
  KEUZE "Hoe kom ik langs de wolven?" ALS vlag ziensteen_terug
    ZEG eldric "Hoe kom ik langs de wolven bij de bosrand?"
    ZEG mira "Ze vrezen licht. Vraag Bram om zijn lantaarn."
    ZEG mira "Zijn vuur is uit, maar jij draagt genoeg licht bij je."
    ZET hint_wolven
  KEUZE "Ik ga maar weer." EINDE
    ZEG eldric "Ik ga maar weer."
    ZEG mira "Pas op in het donker, jongen."
