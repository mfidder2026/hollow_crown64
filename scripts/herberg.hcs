# herberg.hcs — de herberg "De Laatste Straal". Plaatje: data/plaatjes/herberg.png (voorlopig).
KAMER herberg
  LOOPKLEUREN oranje bruin               # de houten vloer
  SCHAAL 100
  LOOPVAK 2,80 157,88                    # 0 achter, langs de toog
  LOOPVAK 2,80 44,124                    # 1 links, bij de haard
  LOOPVAK 96,80 157,124                  # 2 rechts
  LOOPVAK 2,108 157,124                  # 3 voor de tafel langs
  FLAKKER 12,64 16,16 rood oranje geel  # het haardvuur
  ACTOR mira KOSTUUM mira OP 28,96       # Mira, bij de haard

BINNENKOMST:
  ALS vlag tafel_geschoven
    PATCH tafel_weg
  EINDE
  ALS vlag kruik_gepakt
    PATCH kruik_weg
  EINDE

VOORWERP deur "deur" VAK 40,46 11,34 LOOP 45,84 RUG
  GA_NAAR:
    KAMER plein 122,90 VOOR
  BEKIJK:
    ZEG eldric "Naar het plein. Daar is het donker en hier warm."

VOORWERP ziensteen "ziensteen" VAK 58,103 8,7 LOOP 62,112 RUG NERGENS
  BEKIJK:
    ZEG eldric "Een gladde steen met een gat erin. Hij glimt een beetje."
  PAK:
    ZEG eldric "Die neem ik mee. Misschien is iemand hem kwijt."
    GEEF ziensteen

VOORWERP tafel "tafel" VAK 52,88 40,18 LOOP 70,110 RUG
  BEKIJK:
    ZEG eldric "Een eikenhouten tafel. Er ligt iets onder, in het donker."
  DUW:
    ALS vlag tafel_geschoven
      ZEG eldric "Hij staat goed zo."
    ANDERS
      ZEG eldric "Hup."
      PATCH tafel_weg
      ZET tafel_geschoven
      PLAATS ziensteen herberg
      ZEG eldric "Daar ligt een steen. Met een gat erin."
    EINDE
  TREK:
    ZEG eldric "Duwen gaat makkelijker. Denk ik."

VOORWERP kruik "kruik" VAK 140,34 8,10 LOOP 140,86 RUG
  BEKIJK:
    ALS STAND kruik 1
      ZEG eldric "Een kruik vol lampolie. Niet opdrinken."
    ANDERS
      ZEG eldric "Een lege aardewerken kruik."
    EINDE
  PAK:
    ZEG eldric "Een lege kruik. Die kan van pas komen."
    GEEF kruik
    PATCH kruik_weg
    ZET kruik_gepakt

VOORWERP vat "vat" VAK 87,55 13,25 LOOP 92,84 RUG
  BEKIJK:
    ZEG eldric "Een vat lampolie. Er zit een kraantje aan."
  PAK:
    ZEG eldric "Veel te zwaar. Ik neem wel wat in een kruik mee."
  GEBRUIK kruik:
    ALS STAND kruik 1
      ZEG eldric "De kruik is al vol."
    ANDERS
      ZEG eldric "Klok, klok, klok. De kruik zit vol lampolie."
      STAND kruik 1
    EINDE

VOORWERP haard "haard" VAK 4,30 32,50 LOOP 32,86 LINKS
  BEKIJK:
    ZEG eldric "Het enige warme vuur in het dorp. Dit hout komt nog van voor de schemering."
  GEBRUIK zwaard:
    ZEG eldric "Dit vuur brandt al. Het heeft mijn licht niet nodig."

VOORWERP toog "toog" VAK 100,57 59,23 LOOP 120,84 RUG
  BEKIJK:
    ZEG eldric "Flessen, bekers en een plank. Geen waard te zien."

VOORWERP mira "Mira" VAK 22,62 13,36 LOOP 42,100 LINKS
  BEKIJK:
    ZEG eldric "Mira. Ze is blind, maar ze kijkt dwars door me heen."
  PRAAT:
    PRAAT mira
  GEEF ziensteen:
    ZEG eldric "Is dit van u?"
    ZEG mira "Mijn ziensteen! Ik voel het aan het gat. Dank je, Wachter."
    NEEM ziensteen
    ZET ziensteen_terug
    ZEG mira "Ah, nu zie ik het pad weer. Het loopt langs de wolven."
    ZEG mira "Schaduwwolven vrezen licht. Bram de smit heeft een lantaarn."
    ZET hint_wolven
  GEEF munt:
    ZEG mira "Een munt uit de fontein? Hou hem maar. Wensen zijn niet te koop."

GESPREK mira
  KEUZE "Wie bent u?"
    ZEG eldric "Wie bent u?"
    ZEG mira "Mira. Ik zie niets, maar ik zie paden. Meestal."
  KEUZE "Ik moet het Duisterwoud in." ALS NIET vlag ziensteen_terug
    ZEG eldric "Ik moet het Duisterwoud in. Kunt u me de weg wijzen?"
    ZEG mira "Zonder mijn ziensteen zie ik geen enkel pad."
    ZEG mira "Hij rolde weg, daar bij de tafel. Onder de tafel, denk ik."
    ZET mira_zoekt
  KEUZE "Hoe kom ik langs de wolven?" ALS vlag ziensteen_terug
    ZEG eldric "Hoe kom ik langs de wolven bij de bosrand?"
    ZEG mira "Ze vrezen licht. Vraag Bram om zijn lantaarn."
    ZEG mira "Zijn vuur is uit, maar jij draagt genoeg licht bij je."
    ZET hint_wolven
  KEUZE "Ik ga maar weer." EINDE
    ZEG eldric "Ik ga maar weer."
    ZEG mira "Pas op in het donker, Wachter."
