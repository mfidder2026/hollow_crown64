# spel.hcs — het begin van het spel.
# BEGIN kamer x,y richting   (richting: VOOR, RUG, RECHTS, LINKS)
BEGIN plein 60,112 VOOR
# Na het titelscherm eerst de verhaalanimatie (scripts/verhaal.hcs); die gaat daarna zelf naar het plein
VERHAAL verhaal 79,124 RUG
# De hoofdstukken: titel onderaan, en de vlag die het afsluit ("Hoofdstuk n voltooid")
HOOFDSTUK 1 "Dawnhaven" hoofdstuk1_klaar
HOOFDSTUK 2 "Duisterwoud" hoofdstuk2_klaar
HOOFDSTUK 3 "Zee van Vergetelheid" hoofdstuk3_klaar
HOOFDSTUK 4 "Rotskloof" hoofdstuk4_klaar
HOOFDSTUK 5 "IJstop" hoofdstuk5_klaar
# Tot waar het spel nu speelbaar is (de compiler controleert dat dit te halen is)
DOEL hoofdstuk5_klaar

# Wat Eldric bij zich heeft (en wat later bij hem komt)
VOORWERP zonnesteen "zonnesteen" BIJ eldric
  BEKIJK:
    ZEG eldric "Een warm steentje van oma. Er zit nog een beetje zon in, zei ze."

VOORWERP munt "gouden munt" NERGENS
  BEKIJK:
    ZEG eldric "Een gouden munt uit de fontein. Er staat een zon op. Hoe toepasselijk."

VOORWERP vuursteen "vuursteen" NERGENS
  BEKIJK:
    ZEG eldric "Een vuursteen van Bram. Voor als het licht uitgaat."

VOORWERP lantaarn "lantaarn" NERGENS
  # standen: 0 leeg, 1 olie, 2 brandt, 3 lek en uit (hoofdstuk 4), 4 zwak licht (gloeischub), 5 fel (lichtzwam),
  # 6 fel maar het luikje dicht (de aardstad)
  BEKIJK:
    ALS STAND lantaarn 0
      ZEG eldric "Een lege lantaarn van Bram."
    EINDE
    ALS STAND lantaarn 1
      ZEG eldric "De lantaarn zit vol olie. Nu nog vuur."
    EINDE
    ALS STAND lantaarn 2
      ZEG eldric "De lantaarn brandt. Het licht van de zon, in het klein."
    EINDE
    ALS STAND lantaarn 3
      ZEG eldric "Leeg. Er zit een gaatje in de bodem. Iemand met een mes."
      ZEG mira "Een gloeiend ding zou ook licht geven. Al is het weinig."
    EINDE
    ALS STAND lantaarn 4
      ZEG eldric "Zwak licht van de gloeischub. Net genoeg."
    EINDE
    ALS STAND lantaarn 5
      ZEG eldric "De lichtzwam brandt fel in de lantaarn."
    EINDE
    ALS STAND lantaarn 6
      ZEG eldric "Het luikje is dicht. Binnenin gloeit de lichtzwam."
    EINDE
  GEBRUIK gloeischub:
    ALS STAND lantaarn 3
      ZEG eldric "Ik houd de gloeischub in de lantaarn. Zwak licht, maar licht."
      STAND lantaarn 4
      PUNTEN 10
    ANDERS
      ZEG eldric "Daar heeft de lantaarn nu niets aan."
    EINDE
  GEBRUIK lichtzwammen:
    ALS STAND lantaarn 5
      ZEG eldric "Hij brandt al fel."
    ANDERS
      ALS STAND lichtzwammen 2
        ZEG eldric "Ik stop een lichtzwam in de lantaarn. Wauw. Fel!"
        STAND lantaarn 5
        STAND lichtzwammen 1
        PUNTEN 10
      ANDERS
        ZEG eldric "Die laatste lichtzwam bewaar ik."
      EINDE
    EINDE
  SLUIT:
    ALS STAND lantaarn 5
      ZEG eldric "Ik schuif het luikje dicht. Nu schijnt hij niet meer naar buiten."
      STAND lantaarn 6
    ANDERS
      ZEG eldric "Daar valt niets aan dicht te doen."
    EINDE
  OPEN:
    ALS STAND lantaarn 6
      ZEG eldric "Ik schuif het luikje weer open."
      STAND lantaarn 5
    ANDERS
      ZEG eldric "Hij heeft alleen een luikje. Dat is open."
    EINDE
  GEBRUIK kruik:
    ALS NIET STAND lantaarn 0
      ZEG eldric "Er zit al olie in."
    ANDERS
      ALS STAND kruik 1
        ZEG eldric "Ik giet de olie in de lantaarn."
        STAND lantaarn 1
        STAND kruik 0
        PUNTEN 10
      ANDERS
        ZEG eldric "De kruik is leeg."
      EINDE
    EINDE
  GEBRUIK zonnesteen:
    ALS STAND lantaarn 1
      ZEG eldric "Ik houd oma's steentje bij de olie... en de lantaarn brandt!"
      STAND lantaarn 2
      PUNTEN 10
    ANDERS
      ALS STAND lantaarn 2
        ZEG eldric "Hij brandt al."
      ANDERS
        ZEG eldric "Er zit nog geen olie in."
      EINDE
    EINDE

# Hoofdstuk 2: wat Eldric in het Duisterwoud vindt
VOORWERP koker "koker" NERGENS
  BEKIJK:
    ZEG eldric "Een holle koker van schors. Iets heeft hem leeggegeten."

VOORWERP fluisterkever "fluisterkever" NERGENS
  BEKIJK:
    ZEG eldric "Een kevertje in een koker. Als het zoemt, hoor ik woorden."
    ZEG mira "Een fluisterkever. De aardmannetjes praten ermee. Hij vertaalt."

VOORWERP sterrenkaart "sterrenkaart" NERGENS
  BEKIJK:
    ZEG eldric "Een kaart vol sterren en lijnen. Gangen onder de kloof, zegt Nul."
  LEES:
    ZEG eldric "Sterren als wegwijzers. Onder de grond. Daar snap ik nog niets van."

VOORWERP lichtzwammen "lichtzwammen" NERGENS
  BEKIJK:
    ALS STAND lichtzwammen 2
      ZEG eldric "Twee lichtzwammen van Pad. Eén keer fel licht per stuk."
    ANDERS
      ZEG eldric "Nog één lichtzwam over. Die bewaar ik."
    EINDE

VOORWERP trilkristal "trilkristal" NERGENS
  BEKIJK:
    ZEG eldric "Een kristal dat trilt in mijn hand. Het wil iets."

VOORWERP bakenkristal "bakenkristal" NERGENS
  BEKIJK:
    ALS STAND bakenkristal 1
      ZEG eldric "Het bakenkristal, veilig in oma's want."
    ANDERS
      ZEG eldric "Het kristal trilt niet meer. Het zingt. Voor het zonnebaken."
    EINDE
  GEBRUIK want:
    ALS STAND bakenkristal 1
      ZEG eldric "Ik heb het al vast, met de want."
    ANDERS
      ZEG eldric "Ik trek oma's want aan en pak het kristal vast. Het voelt warm, niet heet."
      STAND bakenkristal 1
      PUNTEN 5
    EINDE

VOORWERP sleutelschub "sleutelschub" NERGENS
  BEKIJK:
    ZEG eldric "Een schub van Moeder Aard. Hij opent de poort van het kasteel."

VOORWERP want "wollen want" NERGENS
  BEKIJK:
    ZEG eldric "Een wollen want van oma. Voor het baken. Het bijt, zei ze."

VOORWERP gloeischub "gloeischub" NERGENS
  BEKIJK:
    ZEG eldric "Een schub die zacht gloeit. Een klein beetje licht, van een aardmannetje."

# Wie praat, in welke kleur (berichten bovenaan, op rij 0-1)
SPREKER eldric geel
SPREKER bram oranje
SPREKER mira cyaan
SPREKER grom lichtgroen
SPREKER tik wit
SPREKER kever lichtblauw
SPREKER aardmannetje roze
SPREKER olm grijs
SPREKER nul groen
SPREKER pad lichtgroen
SPREKER oma roze

# Figuren die overal mee kunnen (geen KAMER): Tik verschijnt bij een dood, Mira loopt mee vanaf hoofdstuk 2
ACTOR tik KOSTUUM tik OP 120,40 VERBORGEN
ACTOR mira_mee KOSTUUM mira OP 80,100 VERBORGEN VOLGT

# Tik, de Terugdraaier: na een dood ("TOON tik", zijn droge regel, "PRAAT tik_vraag")
GESPREK tik_vraag
  KEUZE "Ja, terugdraaien." EINDE
    ZEG tik "Daar gaan we weer."
    TERUG
SPREKER verteller lichtgrijs

# Standaardantwoorden: als een voorwerp geen script heeft voor dat werkwoord
STANDAARD BEKIJK:
  ZEG eldric "Niets bijzonders."
STANDAARD PAK:
  ZEG eldric "Dat krijg ik niet mee."
STANDAARD GEBRUIK:
  ZEG eldric "Daar weet ik niets mee te doen."
STANDAARD OPEN:
  ZEG eldric "Dat gaat niet open."
STANDAARD SLUIT:
  ZEG eldric "Dat gaat niet dicht."
STANDAARD PRAAT:
  ZEG eldric "Daar valt niet mee te praten."
STANDAARD GEEF:
  ZEG eldric "Daar heb ik niets voor."
STANDAARD DUW:
  ZEG eldric "Het geeft niet mee."
STANDAARD TREK:
  ZEG eldric "Er zit geen beweging in."
STANDAARD LEES:
  ZEG eldric "Er staat niets op."
