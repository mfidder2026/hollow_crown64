# diepwoud.hcs — achter de spookbrug: het hart van het Duisterwoud, en het begin van het doolhof (hoofdstuk 2).
# Plaatje: data/plaatjes/diepwoud.png (tools/teken_woud2.py). Het doolhof: vier schermen, om en om dit plaatje en
# wolfspad. Elk scherm heeft vier uitgangen (links, rechts, achter links, achter rechts); één route brengt je bij de
# hut, elke andere afslag eindigt weer bij de brug. De weg: de voetsporen van Grom (Bekijk sporen).
#   scherm 1 (hier, geen vlag)       achter links  -> doolhof1
#   scherm 2 (wolfspad, doolhof1)    rechts        -> doolhof2
#   scherm 3 (hier, doolhof2)        achter rechts -> doolhof3
#   scherm 4 (wolfspad, doolhof3)    links         -> de hut (hut_gevonden)
KAMER diepwoud
  LOOPKLEUREN bruin oranje donkergrijs zwart geel grijs lichtgrijs groen lichtgroen lichtblauw blauw cyaan wit
  SCHAAL 106 96
  LOOPVAK 10,108 150,122                 # 0 de open plek
  LOOPVAK 2,108 24,120                   # 1 links
  LOOPVAK 136,106 157,117                # 2 rechts
  LOOPVAK 34,86 40,108                   # 3 achter links
  LOOPVAK 120,86 126,108                 # 4 achter rechts
  BINNENKOMST:
    MUZIEK woud
    ALS NIET vlag doolhof_gezien
      ZET doolhof_gezien
      ZEG mira "Alle paden lijken op elkaar. Volg de sporen van Grom!"
    EINDE

VOORWERP dw_links "pad links" VAK 0,102 8,20 LOOP 4,114 LINKS
  GA_NAAR:
    ALS NIET vlag doolhof2
      KAMER spookbrug 40,108 LINKS
    EINDE
    ZEG eldric "Hier links af... Ik weet het bijna zeker."
    WIS doolhof1
    WIS doolhof2
    WIS doolhof3
    ZET verdwaald
    KAMER spookbrug 40,108 LINKS
  BEKIJK:
    ALS vlag doolhof2
      ZEG eldric "Een pad naar links, het donker in."
    ANDERS
      ZEG eldric "Daar ligt de brug. Terug, als het moet."
    EINDE

VOORWERP dw_rechts "pad rechts" VAK 152,100 8,20 LOOP 156,110 RECHTS
  GA_NAAR:
    ZEG eldric "Rechtsaf. Dat voelt goed."
    WIS doolhof1
    WIS doolhof2
    WIS doolhof3
    ZET verdwaald
    KAMER spookbrug 40,108 LINKS
  BEKIJK:
    ZEG eldric "Een pad naar rechts, langs de omgevallen stam."

VOORWERP dw_tunnel_l "tunnel links" VAK 26,64 22,20 LOOP 37,88 RUG
  GA_NAAR:
    ALS vlag doolhof2
      ZEG eldric "Tussen de struiken door..."
      WIS doolhof1
      WIS doolhof2
      WIS doolhof3
      ZET verdwaald
      KAMER spookbrug 40,108 LINKS
    EINDE
    ZET doolhof1
    KAMER wolfspad 80,122 RUG
  BEKIJK:
    ZEG eldric "Een donkere tunnel in de struiken, links."

VOORWERP dw_tunnel_r "tunnel rechts" VAK 112,64 22,20 LOOP 123,88 RUG
  GA_NAAR:
    ALS vlag doolhof2
      ZET doolhof3
      KAMER wolfspad 80,122 RUG
    EINDE
    ZEG eldric "Tussen de struiken door..."
    WIS doolhof1
    ZET verdwaald
    KAMER spookbrug 40,108 LINKS
  BEKIJK:
    ZEG eldric "Een donkere tunnel in de struiken, rechts."

VOORWERP dw_sporen "sporen" VAK 52,110 50,12 LOOP 80,118 VOOR
  BEKIJK:
    ALS vlag doolhof2
      ZEG eldric "De sporen van Grom. Ze gaan de tunnel rechts in."
    ANDERS
      ZEG eldric "Sporen zo groot als een badkuip. Ze gaan de tunnel links in."
    EINDE
  PAK:
    ZEG eldric "Een voetspoor meenemen? Met de modder erbij?"

VOORWERP dw_uil "uil" VAK 62,40 14,18 LOOP 80,110 RUG
  BEKIJK:
    ZEG eldric "Een uil in een holle boom. Hij kijkt alsof hij de weg weet."
  PRAAT:
    ZEG eldric "Weet jij de weg naar de hut?"
    ZEG eldric "..."
    ZEG mira "Uilen praten niet, Eldric. Kijk naar de grond."

VOORWERP dw_boom "oude boom" VAK 50,4 40,36 LOOP 80,110 RUG
  BEKIJK:
    ZEG eldric "Deze boom stond hier al lang voor de manen vastzaten."

VOORWERP spinnenweb "spinnenweb" VAK 20,44 20,20 LOOP 30,110 RUG
  BEKIJK:
    ZEG eldric "Een spinnenweb met een rode spin."
  PAK:
    ZEG eldric "Nee. Zij was hier eerst."

VOORWERP gloeizwammen "gloeizwammen" VAK 138,88 20,14 LOOP 140,110 RUG
  BEKIJK:
    ZEG eldric "Paddenstoelen die blauw licht geven."
  PAK:
    ZEG mira "Laat staan. Anders is het hier pikdonker."
