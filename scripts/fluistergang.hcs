# fluistergang.hcs — hoofdstuk 4: de gang van de stad van de aardmannetjes naar de spreukzaal, waar Grom ooit zijn
# spreuk sprak. Tekens van die spreuk gloeien op de wanden; uit het zwarte gat waait een koude wind. Plaatje:
# data/plaatjes/fluistergang.png (tools/teken_tussen.py). Een loopscherm: links de stad, rechts de spreukzaal.
KAMER fluistergang
  LOOPKLEUREN bruin oranje donkergrijs zwart grijs
  LOOPVAK 2,106 157,120                  # de gang
  BINNENKOMST:
    MUZIEK kelder
    ALS NIET vlag fluistergang_gezien
      ZET fluistergang_gezien
      ZEG eldric "Moeder Aard zei: in de spreukzaal sprak Grom zijn spreuk. Daar moeten we heen."
      ZEG mira "Ik hoor iets fluisteren. Het komt van daar. Uit iets heel diep."
    EINDE

VOORWERP fg_terug "stad" VAK 0,96 6,28 LOOP 4,112 LINKS
  GA_NAAR:
    KAMER aardstad 146,104 LINKS
  BEKIJK:
    ZEG eldric "Terug naar de stad van de aardmannetjes."

VOORWERP fg_verder "spreukzaal" VAK 154,96 6,28 LOOP 156,112 RECHTS
  GA_NAAR:
    KAMER spreukzaal 16,114 RECHTS
  BEKIJK:
    ZEG eldric "Daar is een zaal. En een gat, zwarter dan de nacht."

VOORWERP fg_tekens "tekens" VAK 26,26 110,62 LOOP 70,112 RUG
  BEKIJK:
    ZEG eldric "Tekens die blauw gloeien. Hoe dichter bij de zaal, hoe feller."
    ZEG mira "Dat is zijn spreuk. Ze is nog niet uitgewerkt."

VOORWERP fg_gat "gat" VAK 138,30 22,64 LOOP 140,112 RECHTS
  BEKIJK:
    ZEG eldric "Er waait een koude wind uit. Het fluistert mijn naam. Brr."
