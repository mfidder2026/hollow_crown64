# bosrand.hcs — de rand van het Duisterwoud. Plaatje: data/flux/bosrand.png (FLUX, uit ons eigen voorlopige plaatje;
# twee van de drie schaduwwolven staan in het plaatje, tools/flux_patches.py bosrand; de patch wolven_weg haalt ze weg).
KAMER bosrand
  LOOPKLEUREN groen lichtgroen geel oranje
  SCHAAL 104 94
  LOOPVAK 2,112 157,124                  # 0 voor
  LOOPVAK 2,92 118,124                   # 1 links en het pad
  LOOPVAK 126,92 157,124                 # 2 rechts van de wegwijzer
  ACTOR wolf KOSTUUM wolf OP 80,90       # de derde schaduwwolf, waar het pad het bos in gaat
  BINNENKOMST:
    MUZIEK bosrand                     # spannend
    ALS vlag wolven_weg
      PATCH wolven_weg
    EINDE
  ACTOR grom KOSTUUM grom OP 80,62 VERBORGEN   # Grom de tovertrol, tussen de bomen (tussenscène; docs/VERHAAL.md)
  ACTOR mira_bos KOSTUUM mira OP 150,124 VERBORGEN   # Mira komt aanlopen (einde hoofdstuk 1); daarna reist ze mee

VOORWERP dorp "dorp" VAK 52,114 56,14 LOOP 80,124 VOOR      # het gele pad onderaan: daar kwam je vandaan
  GA_NAAR:
    KAMER plein 84,66 VOOR
  BEKIJK:
    ZEG eldric "Terug naar Dawnhaven."

VOORWERP wegwijzer "wegwijzer" VAK 112,78 24,34 LOOP 116,114 RUG
  LEES:
    ZEG eldric "'Duisterwoud.' En met krijt eronder: 'Niet doen.'"
  BEKIJK:
    ZEG eldric "Een wegwijzer. Er staat iets op."

VOORWERP bospad "pad" VAK 68,58 24,22 LOOP 80,94 RUG
  BEKIJK:
    ZEG eldric "Het pad het Duisterwoud in. Daar komen de aardmannetjes vandaan."
  GA_NAAR:
    ALS vlag wolven_weg
      ALS NIET vlag hoofdstuk2_begonnen
        ZET hoofdstuk2_begonnen
        KAMER grot 80,116 VOOR             # eerst de tussenscène (scripts/grot.hcs): die begint hoofdstuk 2
      EINDE
      KAMER bospad 92,122 RUG
    ANDERS
      ZEG eldric "Daar ga ik niet zomaar in. Nog niet."
    EINDE

VOORWERP wolven "wolven" VAK 28,80 82,12 LOOP 80,100 RUG
  BEKIJK:
    ALS vlag wolven_weg
      ZEG eldric "Weg zijn ze. Alleen hun pootafdrukken nog."
    ANDERS
      ZEG eldric "Schaduwwolven. Ze laten niemand door. Ogen als kolen."
    EINDE
  PRAAT:
    ALS vlag wolven_weg
      ZEG eldric "Er is niemand meer om tegen te praten."
    ANDERS
      GELUID wolf
      ZEG eldric "Brave hondjes?"
      ZEG eldric "Nee. Geen brave hondjes."
    EINDE
  GEBRUIK zonnesteen:
    ZEG eldric "Het steentje is warm, maar het zijn er te veel. Ik heb meer licht nodig."
  GEBRUIK lantaarn:
    ALS vlag wolven_weg
      ZEG eldric "Ze zijn al weg."
    ANDERS
      ALS STAND lantaarn 2
        TUSSENSCENE
        ZEG eldric "Ksst! Weg jullie! Kijk, licht!"
        GELUID wolf
        PATCH wolven_weg                   # de twee wolven in het plaatje vluchten het bos in
        LOOP wolf 4,90
        VERBERG wolf
        ZET wolven_weg
        PUNTEN 25
        WACHT 25
        TOON grom
        WACHT 25
        ZEG grom "Een jongen met een stukje zon in zijn hand..."
        ZEG grom "Interessant. Heel interessant."
        LOOP grom 80,40
        VERBERG grom
        ZEG eldric "Wie... wat was dat? Die ogen. Zo groot als lantaarns."
        TOON mira_bos
        LOOP mira_bos 112,112
        ZEG mira "Wacht op mij, jongen."
        ZEG mira "Het pad vraagt om mij."
        VERBERG mira                       # ze reist mee: in de herberg is ze niet meer
        VERBERG mira_bos
        TOON mira_mee                      # en vanaf nu loopt ze achter Eldric aan (een figuur die overal mee kan)
        ZEG eldric "Ik ben maar een jongen. Maar ik ga mee. Samen dan."
        ZET hoofdstuk1_klaar
        EINDE_TUSSENSCENE
      ANDERS
        ALS STAND lantaarn 1
          ZEG eldric "De lantaarn brandt nog niet. Ik heb vuur nodig."
        ANDERS
          ZEG eldric "Een lege lantaarn schrikt geen wolf af."
        EINDE
      EINDE
    EINDE
