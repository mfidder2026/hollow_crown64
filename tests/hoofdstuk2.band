verwacht_tekst 18 "Ga naar achterdeur"
vuur
wacht_tot_stil
wacht_op_script
wacht 3
verwacht_kamer oever
verwacht muz_lied = 7                  # LIED_ZEE
verwacht_muziek
screenshot oever
cursor 100,172
vuur
cursor 224,72
verwacht_tekst 18 "Trek bel"
vuur
wacht_tot_stil
wacht_op_script
wacht 3
verwacht_vlag hoofdstuk2_klaar 1
verwacht voltooid = 1
verwacht_tekst 24 "          Hoofdstuk 2 voltooid"
screenshot boot
