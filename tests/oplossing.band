# oplossing.band — hoofdstuk 9: het hele hoofdstuk 1 uitspelen, van het plein tot "Hoofdstuk 1 voltooid".
# Werkwoorden: Pak (100,156), Gebruik (180,156), Open (260,156). Ga naar is het standaardwerkwoord.
# Inventaris: links x 20, rechts x 200; rij 22 = y 180, rij 23 = y 188. Volgorde: zoals in de scripts
# (herberg.hcs, kelder.hcs, dan spel.hcs): kruik (20,180), honingpot (200,180), zonnesteen (20,188), lantaarn (200,188).
wacht 3
verwacht_kamer plein

# 1. de herberg open en naar binnen (met het deurgeluid)
cursor 260,156
vuur
cursor 290,60
verwacht_tekst 18 "Open herberg"
vuur
wacht_tot_stil
wacht_op_script
verwacht_vlag herbergdeur_open 1
verwacht gl_laatste = 0                # GL_DEUR
cursor 290,60
vuur
wacht_tot_stil
wacht_op_script
wacht 3
verwacht_kamer herberg

# 2. de kruik pakken; door het luik naar de kelder: de kruik vullen bij het vat, de honingpot pakken
cursor 100,156
vuur
cursor 288,55
verwacht_tekst 18 "Pak kruik"
vuur
wacht_tot_stil
wacht_op_script
verwacht_eigenaar kruik eldric
cursor 180,156
vuur
cursor 20,180
verwacht_tekst 18 "Gebruik kruik"
vuur
wacht 2
cursor 248,133
verwacht_tekst 18 "Gebruik kruik met luik"
cursor 20,156                          # toch maar niet: Ga naar (de zin begint opnieuw)
vuur
cursor 248,133
verwacht_tekst 18 "Ga naar luik"
vuur
wacht_tot_stil
wacht_op_script
wacht 3
verwacht_kamer kelder
verwacht muz_lied = 3                  # LIED_KELDER
verwacht_muziek
cursor 180,156
vuur
cursor 20,180
vuur
wacht 2
cursor 168,86
verwacht_tekst 18 "Gebruik kruik met vat"
vuur
wacht_tot_stil
wacht_op_script
verwacht_stand kruik 1
cursor 100,156
vuur
cursor 296,66
verwacht_tekst 18 "Pak honingpot"
vuur
wacht_tot_stil
wacht_op_script
verwacht_eigenaar honingpot eldric
verwacht_vlag honingpot_gepakt 1
screenshot kelder
cursor 30,60
verwacht_tekst 18 "Ga naar trap"
vuur
wacht_tot_stil
wacht_op_script
wacht 3
verwacht_kamer herberg

# 3. terug naar het plein en naar de smit
cursor 90,76
vuur
wacht_tot_stil
wacht_op_script
wacht 3
verwacht_kamer plein
cursor 26,94
verwacht_tekst 18 "Ga naar smit"
vuur
wacht_tot_stil
wacht_op_script
wacht 3
verwacht_kamer smit
verwacht_slot 0 bram                   # Bram is een figuur, niet meer in het plaatje
verwacht muz_lied = 4                  # LIED_SMIT
verwacht_muziek
screenshot smit_koud

# 4. het smidsvuur aan met de zonnesteen: Bram geeft de lantaarn
cursor 180,156
vuur
cursor 20,188
vuur
wacht 2
cursor 156,78
verwacht_tekst 18 "Gebruik zonnesteen met smidsvuur"
vuur
wacht_tot_stil
wacht_op_script
verwacht_vlag smidsvuur_aan 1
screenshot smit_vuur
verwacht_eigenaar lantaarn eldric
verwacht_tekst 23 "zonnesteen         ↓  lantaarn"

# 5. olie in de lantaarn, en aansteken met de zonnesteen
cursor 180,156
vuur
cursor 20,180
vuur
wacht 2
cursor 200,188
verwacht_tekst 18 "Gebruik kruik met lantaarn"
vuur
wacht_op_script
verwacht_stand lantaarn 1
verwacht_stand kruik 0
cursor 180,156
vuur
cursor 20,188
vuur
wacht 2
cursor 200,188
verwacht_tekst 18 "Gebruik zonnesteen met lantaarn"
vuur
wacht_op_script
verwacht_stand lantaarn 2

# 6. naar de bosrand: smit -> plein -> pad
cursor 292,80
verwacht_tekst 18 "Ga naar deur"
vuur
wacht_tot_stil
wacht_op_script
wacht 3
verwacht_kamer plein
cursor 164,70
verwacht_tekst 18 "Ga naar pad"
vuur
wacht_tot_stil
wacht_op_script
wacht 3
verwacht_kamer bosrand
verwacht voltooid = 0
verwacht muz_lied = 5                  # LIED_BOSRAND
verwacht_muziek
screenshot bosrand_wolf

# 7. de finale: de lantaarn verjaagt de wolven, Grom verschijnt tussen de bomen en verdwijnt, Mira komt erbij
cursor 180,156
vuur
cursor 200,188
verwacht_tekst 18 "Gebruik lantaarn"
vuur
wacht 2
cursor 120,100
verwacht_tekst 18 "Gebruik lantaarn met wolven"
vuur
wacht_tot_stil
wacht 60
verwacht vm_scene = 1                  # de tussenscène loopt
wacht 360
verwacht_tekst 0 "Een jongen met een stukje zon in zijn"
verwacht_slot 0 grom                   # Grom kreeg het slot dat de wolf vrijmaakte
screenshot grom
wacht_op_script
wacht 3
verwacht_vlag wolven_weg 1
verwacht_vlag hoofdstuk1_klaar 1
verwacht vm_scene = 0
verwacht_slot 0 mira_mee               # Mira loopt nu mee (de figuur die overal mee kan)
verwacht voltooid = 1
verwacht gl_laatste = 4                # GL_KLAAR
verwacht_tekst 24 "          Hoofdstuk 1 voltooid"
screenshot voltooid
