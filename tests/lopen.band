# lopen.band — hoofdstuk 2: Eldric loopt naar waar je klikt, via de loopvakken van scripts/plein.hcs.
# Eldric begint op 120,112 (x in schermpixels, y in kamerrijen), kijkend naar voren.
# Richting: 0 voor, 1 rug, 2 rechts, 3 links. Maat: 0 groot ... 3 klein. Cursor-y = kamerrij + 16.
verwacht act_x.w = 120
verwacht act_richting = 0
verwacht act_maat = 0
screenshot begin

# 1. links, het gele pad naar de smidse (vak 1)
cursor 80,108
vuur
wacht_tot_stil
verwacht act_x.w = 80
verwacht act_y = 92
verwacht act_richting = 3          # het laatste stuk liep naar links
verwacht act_maat = 1              # y 92
screenshot links

# 2. achter de fontein, links: via vak 2 omhoog naast de fontein (om een hoek)
cursor 130,89
vuur
wacht_tot_stil
verwacht act_x.w = 130
verwacht act_y = 73
verwacht act_richting = 2
verwacht act_maat = 3              # achteraan: het kleinst
screenshot achter_links

# 3. achter de fontein langs naar rechts, door de waterstraal (VRIJ in het script)
cursor 200,88
vuur
wacht_tot_stil
verwacht act_x.w = 200
verwacht act_y = 72
verwacht act_richting = 2
verwacht act_achter = 0            # rechts van het torentje: niets vóór hem
screenshot achter_rechts

# 3b. terug, precies achter het torentje: het torentje komt vóór hem (voorgrond-sprite, ACHTER in het script)
cursor 156,89
vuur
wacht_tot_stil
verwacht act_x.w = 156
verwacht act_y = 73
verwacht act_richting = 3
verwacht act_achter = 1
screenshot achter_torentje

# 3c. helemaal bovenaan, tussen de fontein en de huizen achteraan: de allerkleinste maat
cursor 176,81
vuur
wacht_tot_stil
verwacht act_x.w = 176
verwacht act_y = 65
verwacht act_richting = 2
verwacht act_maat = 4
verwacht act_achter = 0
screenshot bovenaan

# 4. klik op de voorkant van de fontein: daar kun je niet staan, hij gaat naar het dichtste punt ervoor
cursor 160,110
vuur
wacht_tot_stil
verwacht act_x.w = 160
verwacht act_y = 100
verwacht act_richting = 3
verwacht act_maat = 1
verwacht act_achter = 0            # vóór de fontein: het torentje mag niet over hem heen
screenshot voor_fontein

# 5. klik op een dak: naar het dichtste punt op het pad rechts; onderweg kijken of hij pasjes zet
cursor 220,36
vuur
wacht 40
verwacht act_lopen = 1             # onderweg ...
verwacht stap_index >= 4           # ... met een pas elke 8 beelden,
verwacht stap_index <= 5           # dus na 40 beelden 4 of 5
screenshot onderweg
wacht_tot_stil
verwacht act_x.w = 220
verwacht act_y = 72
verwacht act_richting = 2
verwacht act_maat = 3
screenshot dak

# 6. naar voren
cursor 220,140
vuur
wacht_tot_stil
verwacht act_x.w = 220
verwacht act_y = 124
verwacht act_richting = 0
verwacht act_maat = 0
screenshot voor
