# proef.hcs — proefscripts voor de VM (hoofdstuk 4). Alleen in de testbuild (./build.sh --autotest).
# Samen gebruiken ze elke opcode minstens één keer; tests/vm.band speelt ze af en controleert het resultaat.

KAMER plein
VOORWERP proef_steen "steen" VAK 10,110 4,4 LOOP 12,112 VOOR NERGENS

SCRIPT proef_vlaggen:                  # ZET WIS ALS(NIET) vlag ANDERS EINDE SPRING
  ZET proef_a
  ALS vlag proef_a
    ZET proef_b
  ANDERS
    ZET proef_fout
  EINDE
  ALS NIET vlag proef_a
    ZET proef_fout
  EINDE
  WIS proef_a
  ALS NIET vlag proef_a
    ZET proef_c
  ANDERS
    ZET proef_fout
  EINDE

SCRIPT proef_voorwerpen:               # GEEF NEEM ALS(NIET) HEEFT STAND ALS(NIET) STAND PLAATS
  GEEF munt
  ALS HEEFT munt
    ZET proef_d
  EINDE
  NEEM munt
  ALS NIET HEEFT munt
    ZET proef_e
  EINDE
  STAND fontein 3
  ALS STAND fontein 3
    ZET proef_f
  EINDE
  ALS NIET STAND fontein 2
    ZET proef_g
  EINDE
  PLAATS proef_steen plein

SCRIPT proef_lopen:                    # LOOP KIJK WACHT ZEG STOP
  LOOP eldric 40,110
  KIJK eldric LINKS
  WACHT 20
  ZEG eldric "Proef geslaagd."
  ZET proef_h
  STOP
  ZET proef_fout

SCRIPT proef_scene:                    # TUSSENSCENE EINDE_TUSSENSCENE (en overslaan met vuur)
  TUSSENSCENE
  ZEG eldric "Deze tekst sla je over."
  LOOP eldric 100,112
  WACHT 2000
  EINDE_TUSSENSCENE
  ZET proef_i

# ---- hoofdstuk 5: inventaris ----
KAMER plein
VOORWERP proef_kruik "kruik" VAK 40,104 6,8 LOOP 44,112 VOOR
  PAK:
    ZEG eldric "Een kruik. Leeg."
    GEEF proef_kruik
  GEBRUIK zonnesteen:                      # "Gebruik zonnesteen met kruik" (en andersom: de VM zoekt ook bij de zonnesteen)
    ZEG eldric "Tink."
    ZET proef_paar

VOORWERP proef_appel "appel" NERGENS
VOORWERP proef_brood "brood" NERGENS
VOORWERP proef_kaars "kaars" NERGENS
VOORWERP proef_touw "touw" NERGENS

SCRIPT proef_veel:
  GEEF proef_appel
  GEEF proef_brood
  GEEF proef_kaars
  GEEF proef_touw

# ---- hoofdstuk 7: snel naar de herberg ----
SCRIPT proef_naar_herberg:
  ZET herbergdeur_open
  KAMER herberg 45,86 VOOR

SCRIPT proef_naar_bos:
  KAMER bosrand 80,120 RUG

SCRIPT proef_dood:                     # een dood met Tik (hoofdstuk 2 en verder): terug naar binnenkomst van de kamer
  ZET proef_dood_vlag
  GEEF munt
  TOON tik
  ZEG tik "Dat was dom. Terugdraaien?"
  PRAAT tik_vraag

SCRIPT proef_mira:                     # Mira loopt mee
  TOON mira_mee

# ---- hoofdstuk 2: meteen naar de bosrand, met wat hoofdstuk 1 opleverde (tests/hoofdstuk2.band) ----
SCRIPT proef_hfst2:
  ZET wolven_weg
  ZET hoofdstuk1_klaar
  GEEF honingpot
  TOON mira_mee
  KAMER bosrand 80,94 RUG

# ---- hoofdstuk 2, alles al opgelost: om de uitgangen heen en terug te lopen (tests/rondje_woud.band) ----
SCRIPT proef_hfst2_open:
  ZET wolven_weg
  ZET hoofdstuk1_klaar
  ZET hoofdstuk2_begonnen
  ZET ridder_weg
  ZET helm_gepakt
  ZET kever_gevangen
  ZET vuur_uit
  ZET kooi_open
  GEEF gloeischub
  GEEF helm
  TOON mira_mee
  HOOFDSTUK 2
  KAMER bosrand 80,94 RUG
